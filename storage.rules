rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Bug Screenshots ────────────────────────────────────────────────────
    // Path: bugs/{uid}/{bugId}.png
    // Only the authenticated owner of the file (matched by uid) can read/write.
    match /bugs/{uid}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   // Only allow image uploads (PNG from canvas export)
                   && request.resource.contentType.matches('image/.*')
                   // Max 5MB per screenshot
                   && request.resource.size <= 5 * 1024 * 1024;
    }

    // Block all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
