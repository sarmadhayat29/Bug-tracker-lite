# Gradle resolves packages via `node` from apps/android/android; hoist RN tooling
# so require.resolve('@react-native/gradle-plugin') works under pnpm.
public-hoist-pattern[]=@react-native/gradle-plugin
public-hoist-pattern[]=@react-native-community/*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*react-native*
