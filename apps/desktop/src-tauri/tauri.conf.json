{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bug Tracker Lite",
  "version": "1.0.0",
  "identifier": "com.bugtrackerlite.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @bug-tracker/web dev",
    "beforeBuildCommand": "pnpm --filter @bug-tracker/web build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Bug Tracker Lite",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.supabase.co data:; connect-src 'self' wss://*.supabase.co https://*.supabase.co"
    }
  }
}
