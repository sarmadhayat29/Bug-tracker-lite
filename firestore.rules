rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── profiles ────────────────────────────────────────────────────────────
    // One document per user, keyed by Firebase Auth UID.
    match /profiles/{uid} {
      // Any signed-in user can read profiles (needed for "reported by" display)
      allow read: if request.auth != null;

      // Only the owner can create their own profile with schema validation
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.email is string
                    && request.resource.data.createdAt is number;

      // Owner can update, but uid and email are immutable, with schema validation
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.email is string
                    && request.resource.data.createdAt is number;

      // Profiles are never deleted (data integrity)
      allow delete: if false;
    }

    // ── bugs ─────────────────────────────────────────────────────────────────
    // Core bug reports. Strictly per-user: no one can read another user's bugs.
    match /bugs/{bugId} {
      // Only the bug owner can read
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.createdBy;

      // Only authenticated users creating bugs for themselves
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.createdBy
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.severity in ["low", "medium", "high", "critical"]
                    && request.resource.data.status == "open";

      // Only the owner can update — createdBy is immutable after creation
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.createdBy
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.status in ["open", "in_progress", "resolved"];

      // Only the owner can delete their bugs
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
    }

    // ── activity_logs ────────────────────────────────────────────────────────
    // Immutable audit trail. Written alongside bug creates/updates in a batch.
    match /activity_logs/{logId} {
      // Only the log owner can read their own logs
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Logs are created with valid action types only
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.action in [
                         "bug_created",
                         "status_changed",
                         "screenshot_added",
                         "bug_deleted"
                       ];

      // Logs are IMMUTABLE — no edits, no deletes
      allow update: if false;
      allow delete: if false;
    }

    // Block all other collection paths not explicitly defined above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
