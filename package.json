{
  "name": "bug-tracker-lite",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal cross-platform bug tracking tool (internship MVP)",
  "scripts": {
    "dev:web": "pnpm --filter @bug-tracker/web dev",
    "dev:desktop": "pnpm --filter @bug-tracker/desktop dev",
    "build:shared": "pnpm --filter @bug-tracker/shared build",
    "build:web": "pnpm --filter @bug-tracker/web build",
    "build:extension": "pnpm --filter @bug-tracker/extension build",
    "build:desktop": "pnpm --filter @bug-tracker/desktop build",
    "android": "pnpm --filter @bug-tracker/android start",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "validate:env:web": "node scripts/validate-env.mjs web",
    "validate:env:android": "node scripts/validate-env.mjs android"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8"
  }
}
