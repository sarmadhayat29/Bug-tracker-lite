{
  "name": "@bug-tracker/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Firebase config and types for Bug Tracker Lite",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
